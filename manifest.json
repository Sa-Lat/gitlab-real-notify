{
  "manifest_version": 3,
  "name": "GitLab Real Notify",
  "version": "0.3.2",
  "description": "Browser-Benachrichtigungen für alles, worüber GitLab dich bei „Participate“ per Mail informiert.",
  "permissions": ["storage", "alarms", "notifications"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GitLab Real Notify"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
